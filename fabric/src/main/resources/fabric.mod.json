{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "rassvet_ii"
    ],
    "contact": {
        "homepage": "https://github.com/rassvet2/CMMCollisionExpand",
        "sources": "https://github.com/rassvet2/CMMCollisionExpand"
    },
    "license": "MIT",
    "icon": "assets/cmmce/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.rassvet_ii.cmmce.CMMCollisionExpandMod"
        ],
        "modmenu": [
            "com.rassvet_ii.cmmce.ModMenuIntegration"
        ]
    },
    "mixins": [
        "cmmce.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=21",
        "architectury": ">=${architectury_api_version}"
    },
    "recommends":  {
        "yet_another_config_lib_v3": ">=${modmenu_version}",
        "modmenu": ">=${yacl_version}"
    }
