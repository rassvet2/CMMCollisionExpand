{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "rassvet_ii"
  ],
  "contact": {
    "homepage": "https://github.com/rassvet2/CMMCollisionExpand",
    "sources": "https://github.com/rassvet2/CMMCollisionExpand"
  },
  "license": "MIT",
  "icon": "assets/cmmce/icon.png",
